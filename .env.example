# Public Supabase browser configuration.
# Never put service-role keys, database passwords, Redis credentials,
# broker credentials, S3 secret keys, or observability secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side infrastructure belongs ONLY in the trusted API/worker environment.
# Do not prefix these with VITE_.
# RPW_REDIS_URL=
# RPW_S3_BUCKET=
# RPW_S3_REGION=
# RPW_QUEUE_URL=
# RPW_SEARCH_URL=
# RPW_OTEL_ENDPOINT=
